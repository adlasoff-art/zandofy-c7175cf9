# Variables exposées au build (préfixe VITE_). Ne pas committer de secrets.
# Copier en .env.local pour le dev local.

# Supabase (auth, REST, realtime, edge functions)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Canonical site URL (SEO canonical, OG) — must match Cloudflare primary domain
VITE_SITE_URL=https://zandofy.com

# Supabase Storage Image Transformations (/render/image). Default OFF — Pro quota is
# only 100 origin images/month. Set true only for debug; leave false/absent in prod.
VITE_USE_IMAGE_TRANSFORM=false

# Vercel Edge (meta-injector for Facebook/WhatsApp/Google bots) — same values as above
SITE_URL=https://zandofy.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: Meta Sharing Debugger fb:app_id warning
FACEBOOK_APP_ID=

# Supabase Edge Functions secrets (Dashboard → Edge Functions → Secrets, not VITE_)
# Social product publishing (Facebook → Instagram) — NEVER put these in VITE_*
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=   # long-lived Page access token
# META_IG_BUSINESS_ID=      # Instagram Business account id linked to the Page
# SOCIAL_PUBLISH_ENABLED=true
# SOCIAL_PUBLISH_CRON_SECRET=   # optional; required for unauthenticated cron invokes
# EMBEDDING_PROVIDER=jina   # Recommended — CLIP OpenAI is NOT on HF serverless
# EMBEDDING_API_KEY=        # Jina API key (jina_...) from https://jina.ai — jina-clip-v2, 512 dims
# EMBEDDING_API_URL=        # Optional override (default https://api.jina.ai/v1/embeddings)
# EMBEDDING_MODEL=          # Optional (default jina-clip-v2)
# For custom HF Inference Endpoint instead: EMBEDDING_PROVIDER=huggingface + EMBEDDING_API_URL=<endpoint-url>
# OPENAI_API_KEY=      # Fallback keyword search in visual-search
